# Production Environment Variables
# Copy to .env.production and fill in actual values

# Database
DATABASE_URL=postgresql://user:password@prod-db.example.com:5432/rbxfolio_prod

# Authentication
AUTH_SECRET=your-super-secret-key-min-32-chars-long
NEXTAUTH_URL=https://rbxfolio.com

# Cloudflare R2 (Media Storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_api_token_access_key
R2_SECRET_ACCESS_KEY=your_api_token_secret_key
R2_BUCKET_NAME=rbxfolio-media
R2_REGION=auto
R2_PUBLIC_URL=https://cdn.rbxfolio.com

# Email Service (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Error Tracking (Sentry)
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENTRY_DSN=https://key@sentry.io/project-id

# Monitoring (New Relic)
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
NEW_RELIC_APP_NAME=rbxfolio-production

# API Configuration
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=production

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://api.rbxfolio.com
NEXT_PUBLIC_APP_URL=https://rbxfolio.com

# Feature Flags
NEXT_PUBLIC_FEATURE_PROJECTS=true
NEXT_PUBLIC_FEATURE_MEDIA=true
NEXT_PUBLIC_FEATURE_SEARCH=true
NEXT_PUBLIC_FEATURE_CONTACT=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your-session-secret-min-32-chars
SESSION_MAX_AGE=604800
SESSION_SAME_SITE=lax
SESSION_SECURE=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Performance
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_SENTRY=true

# Security
CORS_ORIGIN=https://rbxfolio.com
CSRF_TOKEN_MAX_AGE=3600
