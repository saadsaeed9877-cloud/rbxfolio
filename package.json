{
  "name": "rbxfolio",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @rbxfolio/database generate",
    "db:migrate": "pnpm --filter @rbxfolio/database migrate",
    "db:push": "pnpm --filter @rbxfolio/database push",
    "db:studio": "pnpm --filter @rbxfolio/database studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  }
}
