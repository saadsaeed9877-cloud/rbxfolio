# ============================================================================
# RbxFolio Environment Configuration
# ============================================================================
# For detailed setup instructions, see: docs/SETUP_GUIDE_COMPLETE.md
# All services support completely free accounts with NO credit card required!
# ============================================================================

# ============================================================================
# DATABASE (Supabase - 500MB free, no card required)
# ============================================================================
# Get from: https://supabase.com → Project Settings → Database
# Format: postgresql://postgres:[PASSWORD]@db.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.supabase.co:5432/postgres

# ============================================================================
# AUTHENTICATION (Better Auth - shared between web and api)
# ============================================================================
# BETTER_AUTH_SECRET: Generate a random 32-character string
# Run this to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# BETTER_AUTH_URL: Your frontend domain
# Local: http://localhost:3000
# Production: https://rbxfolio.tk or your Vercel domain
BETTER_AUTH_URL=http://localhost:3000

# ============================================================================
# WEB (Frontend - Next.js)
# ============================================================================
# API endpoint for frontend to call
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# App URL (used for redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# API (Backend - NestJS)
# ============================================================================
# Port for backend server
PORT=3001

# Directory for file uploads (local storage in development)
UPLOAD_DIR=./uploads

# CORS origin - allow frontend to call backend
CORS_ORIGIN=http://localhost:3000

# ============================================================================
# EMAIL SERVICE - Brevo (300 emails/day free, no card required)
# ============================================================================
# Get from: https://www.brevo.com → Settings → SMTP & API → Create API Key
# API Key format: SG.xxxxx
BREVO_API_KEY=

# Email address to send from
# 
# ⚠️  IMPORTANT: Email Verification Required for Production
# 
# LOCAL DEVELOPMENT (current file):
#   Use: noreply@rbxfolio.local
#   Why: Fake domain for testing, no verification needed
#   Status: ✅ Works with Brevo free tier
#   Example: BREVO_FROM_EMAIL=noreply@rbxfolio.local
#
# PRODUCTION OPTIONS (use in .env.production):
#
#   OPTION A: Real Domain (Recommended)
#   - Get free domain from Freenom: rbxfolio.tk
#   - Verify domain in Brevo → Settings → Domains
#   - Add DNS records provided by Brevo
#   - Wait 24-48 hours for verification
#   - Use: noreply@rbxfolio.tk
#   - Example: BREVO_FROM_EMAIL=noreply@rbxfolio.tk
#
#   OPTION B: Verified Personal Email (Simpler)
#   - Go to Brevo → Settings → Senders
#   - Add your email (e.g., your-email@gmail.com)
#   - Verify email (Brevo sends confirmation link)
#   - Use your verified email
#   - Example: BREVO_FROM_EMAIL=your-email@gmail.com
#
# For local development, just use the local address below:
BREVO_FROM_EMAIL=noreply@rbxfolio.local

# ============================================================================
# FILE STORAGE - Local Filesystem (Completely Free, No Card, No Limits)
# ============================================================================
# Development: Files stored in ./uploads directory
# Production: Specify your upload directory path
# No cloud service needed - saves hundreds of dollars per year!

# Directory where uploaded files are stored
# Dev: ./uploads (relative to project root)
# Production: /var/app/uploads or similar absolute path
UPLOAD_DIR=./uploads
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# ============================================================================
# LOGGING - Winston (File-based, Completely Free, No Trial, No Card)
# ============================================================================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Logs are stored in:
# - logs/error.log (errors only)
# - logs/combined.log (all levels)
# Development: Logs also appear in console
# Production: Logs only in files

# ============================================================================
# APM MONITORING - New Relic (1GB data/month free, no card required)
# ============================================================================
# Get from: https://newrelic.com → Account Settings → License key
# Format: 40-character string
NEW_RELIC_LICENSE_KEY=

# Application name for New Relic dashboard
NEW_RELIC_APP_NAME=rbxfolio-api

# Log level: error, warn, info, debug
NEW_RELIC_LOG_LEVEL=info

# ============================================================================
# PRODUCTION DEPLOYMENT SETTINGS
# ============================================================================
# Only needed when deploying to Render/production
# Copy this file to .env.production and update with production URLs

# NODE_ENV: development, production, test
# NODE_ENV=development

# ============================================================================
# OPTIONAL: Production File Storage (Alternative to Bunny)
# ============================================================================
# If you prefer AWS S3 or Cloudflare R2 instead of Bunny CDN:

# Cloudflare R2 (AWS S3-compatible, $5/month after free tier)
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET_NAME=rbxfolio-media
# R2_PUBLIC_URL=https://media.rbxfolio.com

# AWS S3 (5GB/month free for 12 months)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET_NAME=rbxfolio-media
# S3_PUBLIC_URL=https://rbxfolio-media.s3.amazonaws.com

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. Copy this file: cp .env.example .env
#
# 2. Fill in each value following the instructions above
#    - All services can be set up at NO COST with NO CREDIT CARD
#    - See docs/SETUP_GUIDE_COMPLETE.md for step-by-step guide
#
# 3. Never commit .env to git (already in .gitignore)
#
# 4. For development: .env at project root
#    For production on Render: Add variables via Render dashboard
#
# 5. Common values:
#    - BETTER_AUTH_SECRET: Generate with: 
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    - NEXT_PUBLIC_API_URL:
#      Dev: http://localhost:3001/api/v1
#      Prod: https://api.rbxfolio.tk/api/v1 (after DNS setup)
#    - CORS_ORIGIN:
#      Dev: http://localhost:3000
#      Prod: https://rbxfolio.tk (after DNS setup)
#
# ============================================================================
